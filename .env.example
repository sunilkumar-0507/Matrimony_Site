# Enquiry destination: "server" (bundled Node backend), "web3forms", or "formspree"
VITE_ENQUIRY_PROVIDER=server

# Used when VITE_ENQUIRY_PROVIDER=web3forms (free key from https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=

# Used when VITE_ENQUIRY_PROVIDER=formspree (e.g. https://formspree.io/f/xxxxxxx)
VITE_FORMSPREE_ENDPOINT=

# Bundled Node backend port
PORT=5174
